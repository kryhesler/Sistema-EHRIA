<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Raíz de los estilos de la app (los nombres con punto heredan de aquí). -->
    <style name="Ehria" />

    <!-- Botón principal: acción de la pantalla (medir, restablecer). -->
    <style name="Ehria.Boton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Botón secundario con borde (cancelar, borrar). -->
    <style name="Ehria.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/texto_secundario</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Opción de un selector segmentado (respiración/pulso, hombre/mujer). -->
    <style name="Ehria.Boton.Segmento" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/toggle_texto</item>
        <item name="backgroundTint">@color/toggle_fondo</item>
        <item name="strokeColor">@color/borde</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/toggle_texto</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Título de sección con ícono a la izquierda. -->
    <style name="Ehria.Etiqueta">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/texto_tenue</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/texto_tenue</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Ehria.Tarjeta">
        <item name="android:background">@drawable/fondo_tarjeta</item>
        <item name="android:padding">18dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Ehria.IndicadorNav" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/indicador_nav</item>
    </style>
    <!-- Textos de la barra inferior -->
    <style name="Ehria.TextoNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Modo robot: subtítulos de lo que dice, datos y resultados -->
    <style name="Ehria.Robot" />

    <style name="Ehria.Robot.Subtitulo">
        <item name="android:fontFamily">@font/manrope_light</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">#E2E8F0</item>
    </style>

    <style name="Ehria.Robot.Dato">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">#64748B</item>
    </style>

    <style name="Ehria.Robot.Valor">
        <item name="android:fontFamily">@font/manrope_light</item>
        <item name="android:textSize">68sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Ehria.Robot.Segmento" parent="Ehria.Boton.Segmento">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconSize">16dp</item>
    </style>
</resources>
