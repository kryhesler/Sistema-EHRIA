<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:paddingTop="32dp"
    android:background="#121824">

    <!-- Header App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvAppHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌋 SismoMonitor &amp; VitalSens PRO"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <!-- Tab Selector Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnTabSeismic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌋 Sismología (10s)"
                android:textSize="12sp"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTabBiometric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🩺 Signos Vitales"
                android:textSize="12sp"
                android:backgroundTint="#334155"
                android:textColor="#94A3B8"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= APARTADO 1: SISMOLOGÍA ================= -->
            <LinearLayout
                android:id="@+id/layoutSeismicSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Card Status & 10s Evaluation -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● SISTEMA NORMAL"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#00E676"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:background="#1500E676" />

                        <TextView
                            android:id="@+id/tvNivelMovimiento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sin Actividad Sísmica Sostenida"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#F8FAFC"
                            android:gravity="center"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/tvAceleracionPico"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PGA Inmediato: 0.00 m/s²"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#00E676"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/tvQuake30sTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳ Esperando detección de movimiento sostenido por 10s..."
                            android:textSize="12sp"
                            android:textColor="#38BDF8"
                            android:gravity="center"
                            android:layout_marginTop="10dp" />

                        <Button
                            android:id="@+id/btnRestablecer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="🔕 Silenciar y restablecer"
                            android:textSize="13sp"
                            android:backgroundTint="#475569"
                            android:textColor="#FFFFFF"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Seismograph Chart -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈 SISMOGRAMA EN TIEMPO REAL"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:layout_marginBottom="10dp" />

                        <com.example.detectormovimiento.SismografoView
                            android:id="@+id/sismografoView"
                            android:layout_width="match_parent"
                            android:layout_height="220dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Escala Mercalli -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 INTENSIDAD ESTIMADA (MOVIMIENTO SOSTENIDO 10S)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvMercalliDetalle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Intensidad: I - Imperceptible. Sistema monitoreando."
                            android:textSize="13sp"
                            android:textColor="#CBD5E1"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================= APARTADO 2: SIGNOS VITALES (RESPIRACIÓN Y RITMO CARDÍACO) ================= -->
            <LinearLayout
                android:id="@+id/layoutBiometricSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩺 MEDICIÓN DE SIGNOS VITALES SOBRE EL PECHO"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#38BDF8"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvBiometricInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recuéstate boca arriba, coloca el teléfono plano sobre el centro del pecho, quédate quieto y toca 'Calcular'."
                            android:textSize="12sp"
                            android:textColor="#94A3B8"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btnStartBiometric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🩺 Tocar para Calcular Pulso y Respiración (20s)"
                            android:backgroundTint="#0284C7"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginBottom="12dp" />

                        <ProgressBar
                            android:id="@+id/pbBiometricProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#38BDF8"
                            android:visibility="gone"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvBiometricStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estado: Listo para medir"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#F8FAFC"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <!-- Results display -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:baselineAligned="false">

                            <!-- Frecuencia Respiratoria -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp"
                                android:background="#0F172A">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🫁 RESPIRACIÓN"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#38BDF8" />

                                <TextView
                                    android:id="@+id/tvRpmEstado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sin medición"
                                    android:textSize="12sp"
                                    android:textColor="#38BDF8"
                                    android:gravity="center"
                                    android:layout_marginTop="4dp" />

                                <TextView
                                    android:id="@+id/tvRpmValues"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- RPM"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:textColor="#00E676"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <!-- Ritmo Cardíaco -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp"
                                android:background="#0F172A"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🫀 RITMO CARDÍACO"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#F43F5E" />

                                <TextView
                                    android:id="@+id/tvBpmEstado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sin medición"
                                    android:textSize="12sp"
                                    android:textColor="#F43F5E"
                                    android:gravity="center"
                                    android:layout_marginTop="4dp" />

                                <TextView
                                    android:id="@+id/tvBpmValues"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- BPM"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:textColor="#F43F5E"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAvisoMedico"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Medición orientativa basada en el acelerómetro. No es un dispositivo médico ni reemplaza la evaluación de un profesional de salud."
                            android:textSize="11sp"
                            android:textColor="#94A3B8"
                            android:gravity="center" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>