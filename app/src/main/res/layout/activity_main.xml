<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121824">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Header -->
        <TextView
            android:id="@+id/tvAppHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌋 SismoMonitor &amp; VitalSens PRO"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistema de Monitoreo Sísmico y Biométrico Torácico"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- MÓDULO 1: SISMOLOGÍA Y MOVIMIENTO -->
        <!-- Card 1.1: Seismic Status & PGA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● SISTEMA NORMAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:background="#1500E676" />

                <TextView
                    android:id="@+id/tvNivelMovimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin Actividad Sísmica"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvAceleracionPico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PGA: 0.00 m/s²"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 1.2: Live Seismograph -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 SISMOGRAMA EN TIEMPO REAL (PGA)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="10dp" />

                <com.example.detectormovimiento.SismografoView
                    android:id="@+id/sismografoView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 1.3: Mercalli Intensity Detail -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 INTENSIDAD ESTIMADA (ESCALA MERCALLI)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvMercalliDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Intensidad: I - Imperceptible. Sin movimiento sísmico perceptible en el área."
                    android:textSize="14sp"
                    android:textColor="#CBD5E1"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- MÓDULO 2: MONITOR DE FRECUENCIA RESPIRATORIA (RPM) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🫁 MONITOR DE FRECUENCIA RESPIRATORIA (PECHO)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apoya el teléfono boca arriba sobre tu pecho para medir tus RPM"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvRpmEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analizando..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvRpmValues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- RPM"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Respiraciones Por Minuto (Ventana 30s)"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>