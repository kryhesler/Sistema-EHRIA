<?xml version="1.0" encoding="utf-8"?>
<!-- Configurar el punto de encuentro (pestaña Estación) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lugar (ej.: la cancha de fútbol)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEncuentroNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¿Hacia dónde queda?"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Como lo vería una persona parada frente a la estación, mirándola."
            android:textSize="12sp"
            android:textColor="@color/texto_tenue" />

        <GridLayout
            android:id="@+id/gridDireccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:columnCount="3">

            <Button style="@style/Ehria.Direccion" android:tag="FRENTE_IZQUIERDA" android:text="↖" android:contentDescription="Al frente, a la izquierda" />
            <Button style="@style/Ehria.Direccion" android:tag="FRENTE" android:text="↑" android:contentDescription="Al frente" />
            <Button style="@style/Ehria.Direccion" android:tag="FRENTE_DERECHA" android:text="↗" android:contentDescription="Al frente, a la derecha" />
            <Button style="@style/Ehria.Direccion" android:tag="IZQUIERDA" android:text="←" android:contentDescription="A la izquierda" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:gravity="center"
                android:text="TÚ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />

            <Button style="@style/Ehria.Direccion" android:tag="DERECHA" android:text="→" android:contentDescription="A la derecha" />
            <Button style="@style/Ehria.Direccion" android:tag="ATRAS_IZQUIERDA" android:text="↙" android:contentDescription="Atrás, a la izquierda" />
            <Button style="@style/Ehria.Direccion" android:tag="ATRAS" android:text="↓" android:contentDescription="Atrás" />
            <Button style="@style/Ehria.Direccion" android:tag="ATRAS_DERECHA" android:text="↘" android:contentDescription="Atrás, a la derecha" />
        </GridLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Distancia aproximada (metros)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEncuentroDistancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Cómo llegar (ej.: sal por el pasillo principal)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEncuentroIndicaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="200"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Croquis de evacuación (opcional)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Una foto del plano de la escuela. Si la agregas, se muestra en lugar del mapa dibujado."
            android:textSize="12sp"
            android:textColor="@color/texto_tenue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCroquisVista"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/fondo_resultado"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnElegirCroquis"
                style="@style/Ehria.Boton.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Elegir foto"
                app:icon="@drawable/ic_ubicacion" />

            <Button
                android:id="@+id/btnQuitarCroquis"
                style="@style/Ehria.Boton.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Quitar"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
